NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/rowad_academy?retryWrites=true&w=majority
FRONTEND_ORIGIN=http://localhost:8080
API_BASE_URL=http://localhost:5000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=academy_token
EMAIL_VERIFICATION_SECRET=replace-with-a-different-long-random-secret
EMAIL_VERIFICATION_EXPIRES_IN=1d

# Use "local" during development. Change to "s3" when AWS is configured.
FILE_STORAGE=local
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
S3_SIGNED_URL_EXPIRES_SECONDS=3600

EMAIL_DELIVERY=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Rowad Academy <no-reply@rowad-rme.com>"

# Optional, used only by npm run create-admin
ADMIN_NAME="Admin User"
ADMIN_EMAIL=admin@rowad-rme.com
ADMIN_PASSWORD=replace-with-a-strong-password
