NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rowad_academy
FRONTEND_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:5000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=academy_token
EMAIL_VERIFICATION_SECRET=replace-with-a-different-long-random-secret
EMAIL_VERIFICATION_EXPIRES_IN=1d

AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=replace-me
S3_SIGNED_URL_EXPIRES_SECONDS=3600

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me
EMAIL_FROM="Rowad Academy <no-reply@rowad-rme.com>"
