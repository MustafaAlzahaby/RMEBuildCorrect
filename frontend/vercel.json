{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rme-build-correct-api.vercel.app/api/:path*"
    },
    {
      "source": "/:page(login|register|verify-email|dashboard|admin)",
      "destination": "/index.html"
    },
    { "source": "/library/:path*", "destination": "/index.html" },
    { "source": "/lessons/:id", "destination": "/index.html" }
  ]
}
